{
  "name": "noteflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:headless": "vitest run tests/headless --reporter=dot --bail=1",
    "test": "vitest run --reporter=dot --bail=1",
    "ctx": "node scripts/context_query.mjs",
    "verify:gate": "node scripts/context_query.mjs gate",
    "apk:prepare": "node scripts/prepare_capacitor_android.mjs",
    "apk:trigger": "node scripts/apk_workflow.mjs trigger",
    "apk:pull": "node scripts/apk_workflow.mjs pull",
    "apk:serve": "node scripts/apk_workflow.mjs serve",
    "apk:build:local": "node scripts/apk_workflow.mjs build-local"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "fast-check": "^4.10.2",
    "typescript": "^5.8.2",
    "vite": "^7.3.7",
    "vitest": "^3.0.7"
  }
}
