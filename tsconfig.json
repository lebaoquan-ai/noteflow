{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@db/*": ["src/db/*"],
      "@state/*": ["src/state/*"],
      "@ui/*": ["src/ui/*"],
      "@ai/*": ["src/ai/*"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "vitest.config.ts",
    "vite.config.ts"
  ]
}
